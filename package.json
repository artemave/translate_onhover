{
  "scripts": {
    "build": "yarn test && yarn build-v2 && yarn build-v3",
    "build-v3": "MANIFEST_V3=true NODE_ENV=production webpack && zip -FS -r -j translate_onhover_v3 dist",
    "build-v2": "MANIFEST_V3=false GECKO_ID={73f6509a-074f-457f-bc32-e521bde682f7} NODE_ENV=production webpack && zip -FS -r -j translate_onhover_v2 dist",
    "dev": "webpack --watch",
    "browser": "node scripts/browser.mjs chrome",
    "browser:firefox": "node scripts/browser.mjs firefox",
    "release": "node scripts/release.mjs",
    "test": "yarn test:unit && yarn test:e2e && yarn test:e2e:mv2",
    "test:endpoints": "node --import ./test-support/register-hooks.mjs --test test/endpoints.test.mjs",
    "test:unit": "node --import ./test-support/register-hooks.mjs --test test/*.test.mjs",
    "test:unit:coverage": "node --import ./test-support/register-hooks.mjs --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-exclude='test/**' test/*.test.mjs",
    "test:e2e": "MANIFEST_V3=true webpack && node --import ./test-support/register-hooks.mjs --test test/e2e/*.test.mjs",
    "test:e2e:mv2": "MANIFEST_V3=false GECKO_ID=transover-e2e@test webpack && node --import ./test-support/register-hooks.mjs --test test/e2e-mv2/*.test.mjs",
    "lint": "eslint --ignore-pattern dist .",
    "prepare": "husky install",
    "postinstall": "playwright install chromium"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/plugin-transform-classes": "^7.28.0",
    "babel-loader": "^9.1.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "debug": "^4.3.4",
    "eslint": "^8.30.0",
    "husky": "^8.0.2",
    "playwright": "^1.62.1",
    "publish-browser-extension": "6.2.0",
    "puppeteer": "^25.18.1",
    "web-ext": "^10.8.0",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  },
  "dependencies": {
    "date-fns": "^2.29.3",
    "jquery": "^3.6.3"
  }
}
