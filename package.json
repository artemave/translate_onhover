{
  "scripts": {
    "build": "yarn test && yarn build-v2 && yarn build-v3",
    "build-v3": "MANIFEST_V3=true NODE_ENV=production webpack && zip -FS -r -j translate_onhover_v3 dist",
    "build-v2": "MANIFEST_V3=false NODE_ENV=production webpack && zip -FS -r -j translate_onhover_v2 dist",
    "dev": "webpack --watch",
    "test": "yarn test:unit && yarn test:e2e",
    "test:endpoints": "node --import ./test-support/register-hooks.mjs --test test/endpoints.test.mjs",
    "test:unit": "node --import ./test-support/register-hooks.mjs --test test/*.test.mjs",
    "test:unit:coverage": "node --import ./test-support/register-hooks.mjs --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 test/*.test.mjs",
    "test:e2e": "MANIFEST_V3=true webpack && node --import ./test-support/register-hooks.mjs --test test/e2e/*.test.mjs",
    "test:e2e:coverage": "bash scripts/test-e2e-coverage.sh",
    "lint": "eslint --ignore-pattern dist .",
    "prepare": "husky install",
    "postinstall": "playwright install chromium"
  },
  "devDependencies": {
    "@babel/core": "7.20.7",
    "@babel/plugin-transform-classes": "7.8.6",
    "babel-loader": "^9.1.0",
    "babel-plugin-istanbul": "^8.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "debug": "^4.3.4",
    "eslint": "^8.30.0",
    "husky": "^8.0.2",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "playwright": "^1.62.1",
    "uglifyjs-webpack-plugin": "^2.2.0",
    "v8-to-istanbul": "^9.3.0",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1",
    "webpack-encoding-plugin": "^0.3.1"
  },
  "dependencies": {
    "date-fns": "^2.29.3",
    "dexie": "^4.0.9",
    "jquery": "^3.6.3"
  }
}
